# Used by `npm run dev` / `npm run build` directly on the host. Vite env
# vars are baked into the built bundle at build time — inside Docker these
# are instead passed as build args in docker-compose.yml (see ../docker-compose.yml
# and ./Dockerfile), since a container's runtime environment can't change an
# already-built static bundle.

# Base URL of the Express API (api/) this frontend talks to for auth, key
# management, credits, and usage.
VITE_API_BASE_URL=http://localhost:4001

# LiteLLM's OpenAI-compatible gateway from Phase 1 — shown on /docs as the
# base URL clients should point their own OpenAI SDK at (not this frontend
# talking to it directly for inference).
VITE_LITELLM_BASE_URL=http://localhost:4000
