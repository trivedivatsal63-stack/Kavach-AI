generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  hashedPassword   String
  name             String?
  // Mock credit system — starter balance only. Real deduction logic (tied to
  // LiteLLM spend) is wired in a later phase.
  creditBalanceUsd Decimal  @default(5.0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  apiKeys          ApiKey[]
}

// Placeholder for keys issued via LiteLLM's /key/generate. The actual key
// value is never stored here — only LiteLLM's identifier for it — since
// LiteLLM is the source of truth for the plaintext key and its spend/limits.
model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  litellmKeyId String    @unique
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
}
