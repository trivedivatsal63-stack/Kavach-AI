# Used when running Prisma CLI commands or `npm run dev` directly on the
# host, outside Docker. Copy to .env and fill in the same postgres
# credentials as the root ai-api-platform/.env.
#
# Inside docker-compose, these are overridden by the api service's
# `environment:` block (which uses container hostnames instead of
# localhost) — see ../docker-compose.yml.

# Points at the "dashboard" database on the same postgres instance created
# via postgres/init-multi-db.sh — same database the old Next.js dashboard
# used, now owned by this API instead.
DATABASE_URL=postgresql://postgres:change-me-postgres-password@localhost:5432/dashboard

# Signs/verifies JWTs issued by POST /auth/login and /auth/signup.
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret

# LiteLLM's OpenAI-compatible gateway from Phase 1 — used to generate/
# revoke/update virtual keys and pull usage via LiteLLM's admin API.
LITELLM_BASE_URL=http://localhost:4000
# Same value as LITELLM_MASTER_KEY in the root ai-api-platform/.env.
LITELLM_MASTER_KEY=sk-change-me-master-key

# Port this API listens on.
PORT=4001

# Origin allowed to make CORS requests — the future React (Vite) frontend.
CORS_ORIGIN=http://localhost:5173
