# Copy this file to .env and fill in real values before running
# `docker compose up`. Nothing here is production-safe as-is — the
# passwords below are local-dev placeholders.

# ── Postgres ────────────────────────────────────────────────────────────
# Superuser credentials for the single postgres:16-alpine instance.
# postgres/init-multi-db.sh uses these to create and own the "litellm"
# and "dashboard" databases on first boot. Also used to build LiteLLM's
# DATABASE_URL in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
# Host port postgres is published on (container always listens on 5432).
POSTGRES_PORT=5432

# ── RAG: vector store (Qdrant) ───────────────────────────────────────────
# Host port Qdrant's REST API is published on (container always 6333).
QDRANT_PORT=6333

# ── RAG: embedding service ────────────────────────────────────────────────
# Host port the embedding service is published on.
EMBEDDING_PORT=8002
# Embedding model used for document + query vectors. Multilingual by default.
# IMPORTANT: changing this after documents are indexed changes vector
# dimensions and/or the embedding space — drop the Qdrant collection and
# re-upload documents (see the RAG module README).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Vector dimension must match EMBEDDING_MODEL (this model = 384).
EMBEDDING_DIM=384
# auto | cuda | cpu — auto enables CUDA only when free VRAM is available.
EMBEDDING_PROVIDER=auto
# Minimum free VRAM (MB) before the embedding service uses the GPU. On a
# small shared GPU (e.g. 4GB with the chat model resident) keep this high so
# embeddings run on CPU and never destabilize inference.
EMBEDDING_GPU_MIN_FREE_MB=1536

# ── vLLM (inference engine) ─────────────────────────────────────────────
# HuggingFace model repo to load. Qwen2.5-1.5B-Instruct is unquantized and
# fits comfortably in 8GB VRAM (RTX 5060) at --max-model-len=4096.
# On a 4GB card (e.g. RTX 2050), use the AWQ int4 build instead so the
# weights fit alongside the KV cache:
#   VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Name vLLM exposes this model as on its OpenAI-compatible API — must match
# the "model" field under litellm/config.yaml's model_list.litellm_params.
VLLM_SERVED_NAME=qwen2.5-1.5b
# Fraction of GPU VRAM vLLM may use (weights + KV cache). Lower it if vLLM
# can't start because the card has little free VRAM (desktop apps on a
# shared laptop GPU) or because a larger model needs room.
VLLM_GPU_MEMORY_UTILIZATION=0.85
# Max context length. Small laptops with ~3GB free VRAM should keep this at
# 4096 or lower — the KV cache grows linearly with it.
VLLM_MAX_MODEL_LEN=4096
# Host port vLLM's OpenAI-compatible API is published on.
VLLM_PORT=8000
# Only needed for gated/private HuggingFace models. Qwen2.5-1.5B-Instruct is
# public, so this can be left blank for the default model.
HUGGING_FACE_HUB_TOKEN=

# ── LiteLLM (API gateway) ────────────────────────────────────────────────
# Admin/root key for LiteLLM's proxy — required to call /key/generate and
# other management endpoints, and to authenticate as the proxy admin.
# Generate a real one with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-me-master-key
# Host port LiteLLM's OpenAI-compatible gateway is published on. Point your
# applications and the web dashboard at http://localhost:<this>/v1.
LITELLM_PORT=4000

# ── API (Express) ─────────────────────────────────────────────────────────
# Host port the API is published on.
API_PORT=4001
# Signs/verifies JWTs issued by POST /auth/login and /auth/signup — used in
# backend/src/auth.ts. Generate with: openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret
# Origin allowed to make CORS requests — the React (Vite) frontend.
CORS_ORIGIN=http://localhost:5173

# ── Web (React/Vite frontend) ───────────────────────────────────────────
# Host port the web dashboard is published on.
WEB_PORT=5173
