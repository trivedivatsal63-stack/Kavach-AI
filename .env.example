# Hybrid: host apps + Docker (vLLM + LiteLLM only). Copy to .env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5432

QDRANT_PORT=6333

SEARXNG_PORT=8888

EMBEDDING_PORT=8002
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=cpu
EMBEDDING_GPU_MIN_FREE_MB=1536

# vLLM in Docker — RTX 2050 / 4GB defaults
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ
VLLM_SERVED_NAME=qwen2.5-1.5b
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=2048
VLLM_MAX_NUM_SEQS=4
VLLM_ENFORCE_EAGER=1
VLLM_PORT=8000
HUGGING_FACE_HUB_TOKEN=

LITELLM_MASTER_KEY=sk-change-me-master-key
LITELLM_PORT=4000

API_PORT=4001
JWT_SECRET=change-me-jwt-secret
CORS_ORIGIN=http://localhost:5173

WEB_PORT=5173
