generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  hashedPassword   String
  name             String?
  // Mock credit system — starter balance only. Drives each key's real
  // LiteLLM max_budget at generation/top-up time; not just a display number.
  creditBalanceUsd Decimal   @default(5.0) @db.Decimal(10, 2)
  // Kept so `db push` does not drop an existing column. Superadmin is `role`.
  isAdmin          Boolean   @default(false)
  // "user" | "superadmin" — see utils/roles.ts. Superadmin is the only
  // privileged role; checked on every /admin request from the live DB row,
  // not from the JWT, so a demotion takes effect immediately.
  role             String    @default("user")
  // "active" | "paused" | "blocked" — paused can still log in (read-only);
  // blocked cannot. Soft-delete is deletedAt, not a fourth status, so a
  // blocked user can be restored without losing that distinction.
  status           String    @default("active")
  deletedAt        DateTime?
  emailVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  apiKeys          ApiKey[]
  conversations    Conversation[]

  @@index([role])
  @@index([status])
}

// Short-lived hashed OTPs for signup verification, login 2FA, and password
// reset. Plaintext codes are emailed (or logged when SMTP is unset) and
// never stored. One active row per (email, purpose) at a time — sending a
// new code consumes any previous unused one.
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  purpose    String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  // Signup-only: { passwordHash, name } so the User row is created only
  // after the email is proven. Unused for login/reset.
  payload    Json?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

// The actual key value is never stored here — only LiteLLM's hashed
// token_id — since LiteLLM is the source of truth for the plaintext key
// and its spend/limits.
model ApiKey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  litellmKeyId String    @unique
  // Human label shown in the dashboard (OpenAI-style key management).
  name         String    @default("API key")
  // Non-secret identifier (e.g. sk-…Ab12) so revoked/expired keys stay
  // distinguishable after the one-time reveal. Plaintext is never stored.
  keyPrefix    String    @default("")
  // Null = never expires. LiteLLM enforces this natively at request time.
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
}

// ── RAG module tables ─────────────────────────────────────────────────────
// Declared so `prisma db push` does not treat them as drift. Runtime DDL for
// these tables lives in models/rag/pool.ts (ensureSchema) — same pattern as
// before; no standalone .sql migration files.

model RagDocument {
  id            String      @id
  userId        String      @map("user_id")
  name          String
  mimeType      String      @map("mime_type")
  sizeBytes     BigInt      @map("size_bytes")
  status        String
  error         String?
  embeddingModel String     @map("embedding_model")
  chunkCount    Int         @default(0) @map("chunk_count")
  createdAt     DateTime    @default(now()) @db.Timestamptz @map("created_at")
  deletedAt     DateTime?   @db.Timestamptz @map("deleted_at")
  chunks        RagChunk[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("rag_documents")
}

model RagChunk {
  id          String       @id
  documentId  String       @map("document_id")
  chunkIndex  Int          @map("chunk_index")
  headingPath Json?        @map("heading_path") @db.JsonB
  source      String
  page        Int?
  tokenCount  Int          @default(0) @map("token_count")
  content     String
  document    RagDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // content_tsv (GENERATED ALWAYS AS ... STORED) is NOT declared as a Prisma
  // field here, deliberately. It previously was (as Unsupported, with no
  // Prisma-managed default) to stop db push proposing to drop it -- but
  // confirmed live that db push still tries to ALTER a column Postgres
  // reports as generated, which Postgres flatly refuses. Leaving it fully
  // undeclared means db push never touches it either way; pool.ts's
  // ensureSchema() (unconditional drop+recreate, see models/rag/pool.ts)
  // is the sole owner of its lifecycle, every boot, --accept-data-loss
  // already covers the case where db push decides to drop it as drift.

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("rag_chunks")
}

model RagKey {
  id        String     @id
  userId    String     @map("user_id")
  name      String
  keyHash   String     @unique @map("key_hash")
  tokenId   String     @unique @map("token_id")
  createdAt DateTime   @default(now()) @db.Timestamptz @map("created_at")
  revokedAt DateTime?  @db.Timestamptz @map("revoked_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("rag_keys")
}

// One hidden LiteLLM key per user, used by BOTH the general Chat UI and RAG
// Studio so spend is attributed to the user's real balance — name predates
// general chat, kept as-is (see chatKeys.service.ts).
model RagChatKey {
  userId       String    @id @map("user_id")
  tokenId      String    @unique @map("token_id")
  keyHash      String    @unique @map("key_hash")
  encryptedKey String    @map("encrypted_key")
  createdAt    DateTime  @default(now()) @db.Timestamptz @map("created_at")

  @@map("rag_chat_keys")
}

// ── Conversation history ────────────────────────────────────────────────
// Shared by the general Chat page and RAG Studio (see `mode`). Unlike the
// rag_* tables above, this is a normal Prisma-managed model (db push) — no
// generated columns/custom indexes are needed here, so there's no reason to
// keep it out of Prisma's tracking.

model Conversation {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String    // "chat" | "rag" — see utils/chat.constants.ts CONVERSATION_MODE
  title       String    @default("New chat")
  // RAG mode only: document ids this conversation is scoped to. null means
  // "all of the user's documents". Always null for mode="chat". Set once at
  // creation and never mutated afterward — retroactively changing scope
  // would misrepresent what earlier answers were actually grounded in.
  documentIds Json?     @map("document_ids") @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  messages    Message[]

  @@index([userId, mode, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String       @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String       // "user" | "assistant"
  content          String
  // rag-mode assistant replies only — same Citation[] shape returned by
  // the API today (models/rag/types.ts).
  citations        Json?        @db.JsonB
  // Assistant replies with web search on (either mode) — WebCitation[]
  // shape (services/liveSearch/types.ts). Kept separate from `citations`
  // rather than merged in, so the existing document-citation contract is
  // untouched for every caller that never asks for web search.
  webCitations     Json?        @map("web_citations") @db.JsonB
  promptTokens     Int?         @map("prompt_tokens")
  completionTokens Int?         @map("completion_tokens")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// Superadmin actions (pause/block/delete/revoke). Written by admin.service
// and listed on the admin panel — not used for enforcement.
model AdminAuditLog {
  id           String   @id @default(uuid())
  adminId      String   @map("admin_id")
  targetUserId String?  @map("target_user_id")
  action       String
  detail       Json?    @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([targetUserId])
  @@map("admin_audit_logs")
}
