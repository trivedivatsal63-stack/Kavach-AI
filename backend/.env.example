# Host-side backend env. Copy to .env
# Prefer 127.0.0.1 over localhost on Windows.

DATABASE_URL=postgresql://postgres:change-me-postgres-password@127.0.0.1:5432/dashboard

JWT_SECRET=change-me-jwt-secret

LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=sk-change-me-master-key

CHAT_MODEL=qwen2.5-1.5b

QDRANT_URL=http://127.0.0.1:6333
EMBEDDING_BASE_URL=http://127.0.0.1:8002
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

SEARXNG_URL=http://127.0.0.1:8888

# Optional. If set, this account is promoted to superadmin on boot/login.
# If left empty and no superadmin exists yet, the earliest user is promoted.
SUPERADMIN_EMAIL=

# SMTP for 6-digit email OTPs (signup, login 2FA, password reset).
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM="Kavach <you@gmail.com>"
# If HOST/FROM are empty, OTPs print in the backend terminal instead of email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORT=4001
CORS_ORIGIN=http://localhost:5173

npx prisma db push
