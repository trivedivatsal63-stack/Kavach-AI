# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# === vLLM — Muse Glimmer 30B AWQ/INT4 on RTX A6000 (48GB), 131K native ===
# Verified: cyankiwi/Muse-Glimmer-30B-AWQ-INT4 (compressed-tensors pack-quantized W4A16 group 32, 24.02GB)
# Requires vLLM nightly (PR 51655: muse_glimmer model + parsers). Do NOT use --quantization awq.
# Conservative concurrency: max_num_seqs 4 (recipes allow 16-32; 4 keeps KV headroom for 131K on 48GB).
VLLM_MODEL=cyankiwi/Muse-Glimmer-30B-AWQ-INT4
VLLM_SERVED_NAME=muse-glimmer-30b-awq
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=131072
VLLM_MAX_NUM_SEQS=4
HUGGING_FACE_HUB_TOKEN=
# --- ROLLBACK (Qwen) — keep for instant revert ---
# VLLM_MODEL=stelterlab/Qwen3-30B-A3B-Instruct-2507-AWQ
# VLLM_SERVED_NAME=qwen3-30b-a3b
# VLLM_GPU_MEMORY_UTILIZATION=0.75
# VLLM_MAX_MODEL_LEN=131072
# VLLM_MAX_NUM_SEQS=8

# === LiteLLM ===
LITELLM_MASTER_KEY=sk-change-me-master-key

# === Embedding / RAG ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=auto
EMBEDDING_GPU_MIN_FREE_MB=1536

# === Backend ===
JWT_SECRET=change-me-jwt-secret
CHAT_MODEL=muse-glimmer-30b-awq
RAG_CHAT_MODEL=muse-glimmer-30b-awq
MODEL_MAX_CONTEXT_TOKENS=131072
# --- ROLLBACK CHAT MODEL ---
# CHAT_MODEL=qwen3-30b-a3b
# RAG_CHAT_MODEL=qwen3-30b-a3b
SUPERADMIN_EMAIL=

# SMTP (6-digit email OTPs) — same Gmail app-password setup as local dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Public URLs — DO NOT set these by hand ===
# CORS_ORIGIN, VITE_API_BASE_URL, VITE_LITELLM_BASE_URL are computed
# automatically by scripts/runpod-deploy.sh from RunPod's own
# RUNPOD_POD_ID env var (injected into every pod automatically) and
# appended to the real .env file at deploy time. Leave unset here.
