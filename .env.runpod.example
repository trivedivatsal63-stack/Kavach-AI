# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# === vLLM — Mistral Small 24B Instruct 2501 AWQ on RTX A6000 (48GB) ===
# Verified: stelterlab/Mistral-Small-24B-Instruct-2501-AWQ (AutoAWQ INT4 GEMM, ~14-16GB, Apache-2.0, no gating).
# Native 32K context; tool calls via --tool-call-parser mistral + --tokenizer-mode mistral.
# AWQ repo misses tekken.json so --tokenizer points at the original (see runpod-start-vllm.sh).
# Tuned for RunPod ~100s proxy: 32K context, util 0.70, max_num_seqs 4 (leaves VRAM for embedding).
VLLM_MODEL=stelterlab/Mistral-Small-24B-Instruct-2501-AWQ
VLLM_SERVED_NAME=mistral-small-24b-awq
VLLM_GPU_MEMORY_UTILIZATION=0.70
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=4
HUGGING_FACE_HUB_TOKEN=
# --- ROLLBACK (Muse Glimmer) — keep for instant revert ---
# VLLM_MODEL=cyankiwi/Muse-Glimmer-30B-AWQ-INT4
# VLLM_SERVED_NAME=muse-glimmer-30b-awq
# VLLM_GPU_MEMORY_UTILIZATION=0.65
# VLLM_MAX_MODEL_LEN=65536
# VLLM_MAX_NUM_SEQS=2

# === LiteLLM ===
LITELLM_MASTER_KEY=sk-change-me-master-key

# === Embedding / RAG ===
# auto = GPU when free VRAM >= EMBEDDING_GPU_MIN_FREE_MB; else CPU. Also falls back on CUDA errors.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=auto
EMBEDDING_GPU_MIN_FREE_MB=2048

# === Backend ===
JWT_SECRET=change-me-jwt-secret
CHAT_MODEL=mistral-small-24b-awq
RAG_CHAT_MODEL=mistral-small-24b-awq
MODEL_MAX_CONTEXT_TOKENS=32768
# --- ROLLBACK CHAT MODEL ---
# CHAT_MODEL=muse-glimmer-30b-awq
# RAG_CHAT_MODEL=muse-glimmer-30b-awq
SUPERADMIN_EMAIL=

# SMTP (6-digit email OTPs) — same Gmail app-password setup as local dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Public URLs — DO NOT set these by hand ===
# CORS_ORIGIN, VITE_API_BASE_URL, VITE_LITELLM_BASE_URL are computed
# automatically by scripts/runpod-deploy.sh from RunPod's own
# RUNPOD_POD_ID env var (injected into every pod automatically) and
# appended to the real .env file at deploy time. Leave unset here.
