# === Postgres ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password

# =============================================================================
# TensorRT-LLM — Gemma 4 26B-A4B MoE (AWQ INT4) on RTX A6000 48 GB (SM 86)
# =============================================================================
# NOT Muse Glimmer. Production model is Google Gemma 4 Mixture-of-Experts:
#   total params  25.2B   (all weights must sit in VRAM)
#   active params  3.8B   (8 of 128 experts + 1 shared per token → 4B-class speed)
#   layers            30  (hybrid: sliding-window local + global; SW=1024)
#   native context   256K
#   modalities    text + image (vision ~550M, in the same checkpoint)
#
# Quantization: W4A16 AWQ / QAT-INT4 (4-bit weights, FP16 activations).
# Ampere has no FP8 / NVFP4 — do not use those quants on A6000.
#
# Checkpoint (weights on disk = 17.19 GB):
#   cyankiwi/gemma-4-26B-A4B-it-qat-AWQ-INT4
# Official BF16 google/gemma-4-26B-A4B-it needs ~57.7 GB weights alone → will NOT
# fit a 48 GB card. Always use the 4-bit/AWQ pack below.
#
# Serve path: TensorRT-LLM PyTorch backend (trtllm-serve). Gemma 4 has no
# convert_checkpoint / trtllm-build engine. Pin TRTLLM_VERSION to 1.3.0rc*.
#
# ── VRAM budget (RTX A6000 = 48.00 GB) ─────────────────────────────────────
#
#   Total VRAM                              48.00 GB
#   Platform util floor (TRT_GPU_MEMORY_…)   0.65 × 48 = 31.20 GB  ← LLM hard cap
#   Embedding / reranker reserve             2.00 GB  (EMBEDDING_GPU_MIN_FREE_MB)
#   Left for OS / CUDA / fragmentation       ≈14.8 GB outside the LLM cap
#
#   Inside the 31.20 GB LLM cap:
#     AWQ-INT4 weights (cyankiwi card)      17.19 GB
#     Runtime weight buffers / scales        ≈0.5 GB
#     ─────────────────────────────────────  ≈17.7 GB resident
#     Remaining for paged KV + activations   ≈13.5 GB
#
#   Hybrid attention keeps KV cheap vs dense 30B:
#     ~0.9–1.1 GB FP16 KV per filled 8K sequence (published community figures).
#     13.5 / 1.1 ≈ 12 sequences hard floor; hybrid + block reuse → 16 is safe.
#
#   Chosen production profile (high concurrency):
#     TRT_MAX_MODEL_LEN = 8192
#     TRT_MAX_NUM_SEQS  = 16
#     TRT_MAX_NUM_TOKENS = 16384   (batched prefill/decode token budget)
#
#   Peak estimate: 17.7 + (16 × ~1.0 GB) ≈ 33.7 GB if every seq is full 8K —
#   paged KV + hybrid SWA mean real occupancy stays under the 31.2 GB util
#   target; the free_gpu_memory_fraction clamp in runpod-start-trtllm.sh
#   enforces that at runtime.
# =============================================================================

# Dense Llama 3.1 8B Instruct BF16 — Ampere SM86 safe, ungated HF mirror.
# TRT-LLM 1.3 pytorch has no Gemma2; Gemma4 MoE AWQ needs SM89+.
# Avoid AutoAWQ/GPTQ HF packs here — pytorch llmapi rejects many of them.
TRT_MODEL=unsloth/Meta-Llama-3.1-8B-Instruct
TRT_SERVED_NAME=llama-3.1-8b-instruct
TRT_BACKEND=pytorch
TRT_QUANTIZATION=fp16
TRT_DTYPE=float16
TRT_KV_CACHE_DTYPE=auto
TRT_WEIGHTS_GB=16.0
# Leave empty for dense models. Set VANILLA only for MoE on SM86.
TRT_MOE_BACKEND=
TRT_REASONING_PARSER=
TRT_TOOL_PARSER=

# Profile B: balanced context (≈8 concurrent @ 16K)
TRT_MAX_MODEL_LEN=16384
TRT_MAX_NUM_SEQS=8
TRT_MAX_NUM_TOKENS=16384
TRT_TOKENS_PER_BLOCK=64
TRT_GPU_MEMORY_UTILIZATION=0.70

# PyPI has no rc16/rc17 — after rc15 the next published builds are rc22+.
TRTLLM_VERSION=1.3.0rc24
HUGGING_FACE_HUB_TOKEN=
# Accept the Gemma 4 / Apache-2.0 model license on Hugging Face, then set token.

# --- Profile A: high concurrency (≈16 concurrent @ 8K) ---
# TRT_MAX_MODEL_LEN=8192
# TRT_MAX_NUM_SEQS=16
# TRT_MAX_NUM_TOKENS=16384
# MODEL_MAX_CONTEXT_TOKENS=8192

# --- Profile C: long context (≈4 concurrent @ 32K) ---
# TRT_MAX_MODEL_LEN=32768
# TRT_MAX_NUM_SEQS=4
# TRT_MAX_NUM_TOKENS=8192
# MODEL_MAX_CONTEXT_TOKENS=32768

# --- Profile D: max throughput short prompts (≈32 concurrent @ 4K) ---
# TRT_MAX_MODEL_LEN=4096
# TRT_MAX_NUM_SEQS=32
# TRT_MAX_NUM_TOKENS=16384
# MODEL_MAX_CONTEXT_TOKENS=4096

# --- DO NOT use on A6000 48GB ---
# TRT_MODEL=google/gemma-4-26B-A4B-it   # BF16 ≈57.7 GB weights alone
# TRT_QUANTIZATION=fp16

# === LiteLLM ===
LITELLM_MASTER_KEY=sk-change-me-master-key
# Supervisord sets VLLM_API_BASE=http://127.0.0.1:8000/v1 → TRT-LLM OpenAI server.

# === Embedding / RAG (shares the same GPU; kept outside the 0.65 LLM cap) ===
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=auto
EMBEDDING_GPU_MIN_FREE_MB=2048

# === Backend ===
JWT_SECRET=change-me-jwt-secret
CHAT_MODEL=llama-3.1-8b-instruct
RAG_CHAT_MODEL=llama-3.1-8b-instruct
# MUST equal TRT_MAX_MODEL_LEN (RAG token-budget cutoff).
MODEL_MAX_CONTEXT_TOKENS=16384
SUPERADMIN_EMAIL=

# SMTP (6-digit email OTPs)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# === Public URLs — DO NOT set these by hand ===
# CORS_ORIGIN, VITE_API_BASE_URL, VITE_LITELLM_BASE_URL are computed by
# scripts/runpod-deploy.sh from RUNPOD_POD_ID. Leave unset here.
